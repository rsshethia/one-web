---
import JobList from '../components/JobList';
import Map from '../components/Map';
import rows from '../data/lga_jobs.json';

const state = 'Victoria';
const total = rows.reduce((s, r) => s + r.jobs_count, 0);
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{state} Council Jobs Map</title>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.js"></script>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.css" rel="stylesheet" />
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: -apple-system, "Segoe UI", Roboto, sans-serif; }
  #app { display: flex; height: 100vh; }
  #map { width: 50%; height: 100%; }
  #side { width: 50%; height: 100%; overflow-y: auto; padding: 20px 24px; background: #fafafa; }
</style>
</head>
<body>
<div id="app">
  <div id="map"><Map rows={rows} onPick={() => {}} client:visible /></div>
  <div id="side">
    <h1>{state} council jobs</h1>
    <p>{rows.length} councils · {total} open roles</p>
    <JobList rows={rows} state={state} client:visible />
  </div>
</div>
</body>
</html>
