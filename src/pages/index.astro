---
import App from '../components/App';
import rows from '../data/lga_jobs.json';

const state = 'Victoria';
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{state} Council Jobs — map, list & analytics</title>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.js"></script>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.css" rel="stylesheet" />
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: -apple-system, "Segoe UI", Roboto, sans-serif; }
  .app-shell { height: 100vh; height: 100dvh; display: flex; flex-direction: column; }
  .topnav { display: flex; align-items: center; gap: 4px; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e2e2e2; overflow-x: auto; }
  .topnav .brand { margin-right: 12px; font-size: 15px; white-space: nowrap; }
  .topnav .role-count { font-size: 12px; color: #666; margin-right: 12px; white-space: nowrap; }
  .topnav .gh-link { font-size: 14px; color: #0b4ea2; text-decoration: none; white-space: nowrap; padding: 10px 4px; }
  .page-wrap { margin: 0 auto; padding: 20px 24px; }
  .page-wrap.narrow { max-width: 860px; }
  .page-wrap.wide { max-width: 960px; }
  .map-layout { display: flex; height: 100%; }
  .map-pane { width: 55%; height: 100%; }
  .detail-pane { width: 45%; height: 100%; overflow-y: auto; padding: 20px 24px; background: #fafafa; }
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .bento .span-half { grid-column: span 2; }
  .bento .span-all { grid-column: span 4; }
  .hrow-name { width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: none; }
  @media (max-width: 760px) {
    .topnav .brand { display: none; }
    .map-layout { flex-direction: column; }
    .map-pane { width: 100%; height: 42vh; flex: none; }
    .detail-pane { width: 100%; flex: 1; min-height: 0; padding: 16px; }
    .page-wrap { padding: 16px 12px; }
    .bento { grid-template-columns: repeat(2, 1fr); }
    .bento .span-half, .bento .span-all { grid-column: span 2; }
    .hrow-name { width: 110px; }
  }
</style>
</head>
<body>
<App rows={rows} state={state} client:load />
</body>
</html>
